

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "source": "~/wallpaper/15.png",
      "type": "kitty",
    	"height": 7,
    	"padding": {
    		"top": 1,
            "left": 2
      }
    },
    "display": {
        "separator": "   "
    },
    "modules": [
	"break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "31",  // = color1
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "32",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "PKG ",
            "keyColor": "33",  
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "34", 
        },
        {
            "type": "terminal",
            "key": "TER ",
            "keyColor": "35", 
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "36", 
        },
        {
          "type": "publicip",
          "key": "IP  ",
          "keyColor": "37",  
        },
        {
          "type": "localip",
          "key": "IP  ",
          "keyColor": "38",  
        },
        // {
        //   "type": "weather",
        //   "key": "WHE ",
        //   "keyColor": "38",
        // },
        "break",
    ]
}